{
  "name": "@signalsafe/simulator-theme-bootstrap",
  "version": "0.13.2",
  "type": "module",
  "description": "Bootstrap-token simulator theme for @signalsafe/simulator-device and @signalsafe/simulator-react semantic classes.",
  "license": "MIT",
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "exports": {
    "./styles.css": "./styles.css",
    "./appearance": {
      "types": "./appearance.d.ts",
      "import": "./appearance.js",
      "default": "./appearance.js"
    }
  },
  "files": [
    "styles.css",
    "appearance.js",
    "appearance.d.ts",
    "src/**/*.css",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "smoke:package": "node scripts/smoke-package.mjs",
    "publish:dry-run": "npm pack --dry-run",
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "c8 --all --include=appearance.js --reporter=text --reporter=lcov node --test tests/*.test.mjs",
    "test:layout": "node --test tests/email-layout.browser.mjs"
  },
  "keywords": [
    "simulator",
    "theme",
    "css",
    "bootstrap",
    "signalsafe"
  ],
  "devDependencies": {
    "c8": "^12.0.0",
    "playwright": "1.55.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@signalsafe/simulator-react": "0.21.1",
    "@signalsafe/simulator-device": "0.21.1",
    "vite": "8.3.5"
  }
}
