{
  "name": "@signalsafe/simulator-theme-bootstrap",
  "version": "0.13.4",
  "type": "module",
  "description": "Bootstrap-token simulator theme for @signalsafe/simulator-device and @signalsafe/simulator-react semantic classes.",
  "license": "MIT",
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "exports": {
    "./styles.css": "./styles.css",
    "./appearance": {
      "types": "./appearance.d.ts",
      "import": "./appearance.js",
      "default": "./appearance.js"
    }
  },
  "files": [
    "styles.css",
    "appearance.js",
    "appearance.d.ts",
    "src/**/*.css",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "smoke:package": "node scripts/smoke-package.mjs",
    "publish:dry-run": "npm pack --dry-run",
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "c8 --all --include=appearance.js --check-coverage --lines=100 --branches=100 --functions=100 --statements=100 --reporter=text --reporter=lcov node --test tests/*.test.mjs",
    "test:layout": "node --test tests/email-layout.browser.mjs"
  },
  "keywords": [
    "simulator",
    "theme",
    "css",
    "bootstrap",
    "signalsafe"
  ],
  "devDependencies": {
    "c8": "^12.0.0",
    "playwright": "1.55.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@signalsafe/simulator-react": "file:tests/vendor/npm/signalsafe-simulator-react-0.21.2.tgz",
    "@signalsafe/simulator-device": "file:tests/vendor/npm/signalsafe-simulator-device-0.21.3.tgz",
    "vite": "8.3.5",
    "@signalsafe/simulator-core": "file:tests/vendor/npm/signalsafe-simulator-core-0.7.2.tgz"
  },
  "homepage": "https://signalsafesoftware.github.io/simulator-device/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SignalSafeSoftware/simulator-theme-bootstrap.git"
  },
  "bugs": {
    "url": "https://github.com/SignalSafeSoftware/simulator-theme-bootstrap/issues"
  },
  "overrides": {
    "@signalsafe/simulator-core": "$@signalsafe/simulator-core",
    "@signalsafe/simulator-react": "$@signalsafe/simulator-react",
    "@signalsafe/simulator-device": "$@signalsafe/simulator-device",
    "@signalsafe/simulator-theme-bootstrap": "file:tests/vendor/npm/signalsafe-simulator-theme-bootstrap-0.13.3.tgz"
  }
}
